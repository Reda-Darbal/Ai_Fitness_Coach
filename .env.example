# Clerk (https://dashboard.clerk.com — create an application, copy API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Neon Postgres (https://console.neon.tech — free, no credit card)
# Project dashboard → Connection string → copy the pooled connection string.
DATABASE_URL=

# Together AI (https://api.together.ai)
# Model IDs retire aggressively — keep them env-configured, never hardcoded.
TOGETHER_API_KEY=
TOGETHER_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
TOGETHER_VISION_MODEL=Qwen/Qwen3.5-9B

# Neon Object Storage (S3-compatible) — progress photos. Generate credentials
# in the Neon console under Storage; the bucket is created on first use.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
STORAGE_BUCKET=coach
